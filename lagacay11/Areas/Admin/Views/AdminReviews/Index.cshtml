@model lagacay11.Models.ViewModels.AdminReviewListViewModel
@{
    ViewData["Title"] = "Manage Reviews";
}

<div class="space-y-8">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-4">
        <h3 class="font-display text-headline-md uppercase text-white tracking-wider border-l-4 border-primary pl-4">Customer Reviews</h3>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-dismissible glass-card border-secondary/30 text-white px-6 py-4 flex justify-between items-center mb-4 transition-all duration-500" role="alert">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-secondary">check_circle</span>
                <span class="font-sans text-sm">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="text-on-surface-variant hover:text-white transition-colors flex items-center justify-center bg-transparent border-0" onclick="this.parentElement.remove();" aria-label="Close">
                <span class="material-symbols-outlined text-lg">close</span>
            </button>
        </div>
    }

    <div class="glass-card border border-white/10 rounded-lg overflow-hidden mb-8">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-surface-container-high border-b border-white/10">
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Product</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Customer</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Rating</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Comment</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Date</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Status</th>
                        <th class="px-6 py-4 text-right text-xs uppercase tracking-widest text-primary font-display font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Reviews == null || !Model.Reviews.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-8 text-center text-on-surface-variant text-sm">No reviews submitted yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var review in Model.Reviews)
                        {
                            <tr class="border-b border-white/5 hover:bg-white/2 transition-colors">
                                <td class="px-6 py-4 align-middle font-bold text-sm">
                                    <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@review.ProductId" class="text-white hover:text-primary transition-colors font-display decoration-none" target="_blank">@review.ProductName</a>
                                </td>
                                <td class="px-6 py-4 align-middle text-white text-sm">@review.CustomerName</td>
                                <td class="px-6 py-4 align-middle text-warning text-sm tracking-tighter">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span>@(i <= review.Rating ? "★" : "☆")</span>
                                    }
                                </td>
                                <td class="px-6 py-4 align-middle text-on-surface-variant text-xs max-w-xs truncate" title="@review.Comment">
                                    @review.Comment
                                </td>
                                <td class="px-6 py-4 align-middle text-on-surface-variant text-xs">@review.CreatedAt.ToString("d")</td>
                                <td class="px-6 py-4 align-middle">
                                    @if (review.IsApproved)
                                    {
                                        <span class="inline-block bg-secondary text-on-secondary font-label-bold px-3 py-1 text-[10px] uppercase tracking-wider">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="inline-block bg-primary/20 text-primary font-label-bold px-3 py-1 text-[10px] uppercase tracking-wider border border-primary/30">Pending</span>
                                    }
                                </td>
                                <td class="px-6 py-4 align-middle text-right">
                                    <div class="flex justify-end gap-2">
                                        @if (!review.IsApproved)
                                        {
                                            <form asp-action="Approve" method="post" class="m-0 inline-block">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@review.Id" />
                                                <button type="submit" class="border border-secondary/30 text-secondary hover:bg-secondary/10 text-xs px-3 py-1.5 font-label-bold tracking-widest uppercase transition-colors bg-transparent cursor-pointer">Approve</button>
                                            </form>
                                        }
                                        <form asp-action="Reject" method="post" class="m-0 inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@review.Id" />
                                            <button type="submit" class="border border-error/30 text-error hover:bg-error/10 text-xs px-3 py-1.5 font-label-bold tracking-widest uppercase transition-colors bg-transparent cursor-pointer">Reject</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
