@model lagacay11.Models.ViewModels.AdminUserListViewModel
@{
    ViewData["Title"] = "Manage Users";
    var search = Model.SelectedSearch;
}

<div class="space-y-8">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-4">
        <h3 class="font-display text-headline-md uppercase text-white tracking-wider border-l-4 border-primary pl-4">Registered Collectors</h3>
        
        <!-- Search bar -->
        <form asp-action="Index" method="get" class="flex items-center gap-3 m-0">
            <input type="text" name="search" value="@search" class="bg-background border border-white/10 text-white rounded px-3 py-2 text-xs focus:outline-none focus:border-primary placeholder-on-surface-variant/40 w-64" placeholder="Search by name, email, phone..." />
            <button type="submit" class="bg-primary text-black font-label-bold px-4 py-2 uppercase tracking-widest text-[10px] font-bold hover:opacity-90 transition-opacity rounded-none">Search</button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a asp-action="Index" class="border border-white/20 text-white hover:bg-white/10 text-[10px] px-4 py-2 font-label-bold tracking-widest uppercase decoration-none transition-colors rounded-none">Clear</a>
            }
        </form>
    </div>

    <div class="glass-card border border-white/10 rounded-lg overflow-hidden mb-8">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-surface-container-high border-b border-white/10">
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Full Name</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Email</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Phone Number</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Shipping Address</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Joined Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users == null || !Model.Users.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-on-surface-variant text-sm">No users found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model.Users)
                        {
                            <tr class="border-b border-white/5 hover:bg-white/2 transition-colors">
                                <td class="px-6 py-4 align-middle font-bold text-white text-sm">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="text-primary hover:underline transition-colors decoration-none">@user.FullName</a>
                                </td>
                                <td class="px-6 py-4 align-middle text-white text-sm">@user.Email</td>
                                <td class="px-6 py-4 align-middle text-on-surface-variant text-sm">@user.PhoneNumber</td>
                                <td class="px-6 py-4 align-middle text-on-surface-variant text-xs">@user.Address</td>
                                <td class="px-6 py-4 align-middle text-on-surface-variant text-xs">@user.CreatedAt.ToString("g")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
