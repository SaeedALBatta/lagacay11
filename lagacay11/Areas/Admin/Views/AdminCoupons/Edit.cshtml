@model lagacay11.Models.ViewModels.AdminCouponViewModel
@{
    ViewData["Title"] = "Edit Coupon";
}

<div class="max-w-[1000px] mx-auto">
    <!-- Page Title -->
    <div class="mb-8">
        <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight mb-0">Edit Coupon</h1>
        <p class="text-on-surface-variant font-body-md text-body-md mt-2">Configure discount parameters, usage restrictions, and asset visibility.</p>
    </div>
    
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-6 m-0">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UsageCount" />
        
        <!-- Left Column (Main Config) -->
        <div class="lg:col-span-8 flex flex-col gap-6">
            <!-- Panel: Basic Information -->
            <section class="bg-[#14171C]/60 backdrop-blur-2xl border border-white/10 rounded-xl p-6 md:p-8 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] relative overflow-hidden group">
                <div class="absolute -inset-full bg-gradient-to-tr from-transparent via-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-1000 pointer-events-none"></div>
                <h2 class="font-headline-md text-headline-md text-primary mb-6 flex items-center gap-3">
                    <span class="material-symbols-outlined text-[24px]">info</span>
                    Basic Information
                </h2>
                <div class="space-y-6 relative z-10">
                    <div class="focus-glow rounded-DEFAULT transition-all">
                        <label class="block font-label-bold text-label-bold text-on-surface-variant mb-2">Coupon Code <span class="text-error">*</span></label>
                        <input asp-for="Code" class="w-full bg-[#0A0C10] border border-white/20 text-on-surface font-body-md px-4 py-3 rounded-DEFAULT focus:outline-none placeholder:text-white/20 uppercase tracking-widest" placeholder="e.g. SUMMER24" type="text" required>
                        <span asp-validation-for="Code" class="text-error text-xs mt-1 block"></span>
                    </div>
                    <div class="focus-glow rounded-DEFAULT transition-all">
                        <label class="block font-label-bold text-label-bold text-on-surface-variant mb-2">Description</label>
                        <textarea asp-for="Description" class="w-full bg-[#0A0C10] border border-white/20 text-on-surface font-body-md px-4 py-3 rounded-DEFAULT focus:outline-none placeholder:text-white/20 resize-none" placeholder="Internal notes or description of the campaign..." rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-error text-xs mt-1 block"></span>
                    </div>
                </div>
            </section>
            
            <!-- Panel: Discount Configuration -->
            <section class="bg-[#14171C]/60 backdrop-blur-2xl border border-white/10 rounded-xl p-6 md:p-8 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] relative overflow-hidden group">
                <h2 class="font-headline-md text-headline-md text-primary mb-6 flex items-center gap-3">
                    <span class="material-symbols-outlined text-[24px]">percent</span>
                    Discount Configuration
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-10">
                    <div class="focus-glow rounded-DEFAULT transition-all">
                        <label class="block font-label-bold text-label-bold text-on-surface-variant mb-2">Type</label>
                        <div class="relative">
                            <select asp-for="Type" class="w-full bg-[#0A0C10] border border-white/20 text-on-surface font-body-md px-4 py-3 rounded-DEFAULT focus:outline-none appearance-none pr-10">
                                <option value="percentage">Percentage (%)</option>
                                <option value="fixed">Fixed Amount ($)</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">expand_more</span>
                        </div>
                        <span asp-validation-for="Type" class="text-error text-xs mt-1 block"></span>
                    </div>
                    <div class="focus-glow rounded-DEFAULT transition-all">
                        <label class="block font-label-bold text-label-bold text-on-surface-variant mb-2">Discount Value <span class="text-error">*</span></label>
                        <input asp-for="Value" class="w-full bg-[#0A0C10] border border-white/20 text-on-surface font-body-md px-4 py-3 rounded-DEFAULT focus:outline-none placeholder:text-white/20 text-right font-stats-xl" placeholder="0.00" type="number" step="0.01" required>
                        <span asp-validation-for="Value" class="text-error text-xs mt-1 block"></span>
                    </div>
                </div>
            </section>
        </div>
        
        <!-- Right Column (Meta & Restrictions) -->
        <div class="lg:col-span-4 flex flex-col gap-6">
            <!-- Panel: Visibility -->
            <section class="bg-[#14171C]/60 backdrop-blur-2xl border border-white/10 rounded-xl p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]">
                <h2 class="font-headline-md text-stats-xl text-primary mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">visibility</span>
                    Visibility
                </h2>
                <div class="flex items-center justify-between cursor-pointer group">
                    <div class="flex flex-col">
                        <span class="font-label-bold text-label-bold text-on-surface">Is Active</span>
                        <span class="font-body-md text-sm text-on-surface-variant">Enable for public use</span>
                    </div>
                    <label class="relative inline-flex items-center h-6 rounded-full w-11 transition-colors bg-surface-container-high peer-focus:outline-none group-hover:bg-surface-container-highest border border-white/20 cursor-pointer">
                        <input asp-for="IsActive" class="peer sr-only" type="checkbox">
                        <div class="w-4 h-4 bg-on-surface-variant rounded-full absolute left-1 transition-transform peer-checked:translate-x-5 peer-checked:bg-primary"></div>
                    </label>
                </div>
                <span asp-validation-for="IsActive" class="text-error text-xs mt-1 block"></span>
            </section>
            
            <!-- Panel: Usage & Restrictions -->
            <section class="bg-[#14171C]/60 backdrop-blur-2xl border border-white/10 rounded-xl p-6 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]">
                <h2 class="font-headline-md text-stats-xl text-primary mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">rule</span>
                    Restrictions
                </h2>
                <div class="space-y-6">
                    <div class="focus-glow rounded-DEFAULT transition-all">
                        <label class="block font-label-bold text-label-bold text-on-surface-variant mb-2">Expiration Date</label>
                        <div class="relative">
                            <input type="date" name="ExpirationDate" value="@(Model.ExpirationDate?.ToString("yyyy-MM-dd"))" class="w-full bg-[#0A0C10] border border-white/20 text-on-surface font-body-md px-4 py-3 rounded-DEFAULT focus:outline-none [&::-webkit-calendar-picker-indicator]:filter [&::-webkit-calendar-picker-indicator]:invert opacity-80">
                        </div>
                        <span asp-validation-for="ExpirationDate" class="text-error text-xs mt-1 block"></span>
                    </div>
                    <div class="focus-glow rounded-DEFAULT transition-all">
                        <label class="block font-label-bold text-label-bold text-on-surface-variant mb-2">Usage Limit (Total)</label>
                        <input asp-for="UsageLimit" class="w-full bg-[#0A0C10] border border-white/20 text-on-surface font-body-md px-4 py-3 rounded-DEFAULT focus:outline-none placeholder:text-white/20" placeholder="Unlimited" type="number">
                        <span asp-validation-for="UsageLimit" class="text-error text-xs mt-1 block"></span>
                    </div>
                    <div class="focus-glow rounded-DEFAULT transition-all">
                        <label class="block font-label-bold text-label-bold text-on-surface-variant mb-2">Minimum Purchase ($)</label>
                        <input asp-for="MinimumPurchase" class="w-full bg-[#0A0C10] border border-white/20 text-on-surface font-body-md px-4 py-3 rounded-DEFAULT focus:outline-none placeholder:text-white/20" placeholder="0.00" type="number" step="0.01">
                        <span asp-validation-for="MinimumPurchase" class="text-error text-xs mt-1 block"></span>
                    </div>
                </div>
            </section>
        </div>
        
        <!-- Form Actions Footer -->
        <div class="col-span-1 lg:col-span-12 mt-4 pt-6 border-t border-white/10 flex flex-col-reverse sm:flex-row justify-end gap-4 pb-12 md:pb-0">
            <a asp-action="Index" class="px-8 py-3 rounded-DEFAULT border border-white/20 text-on-surface font-label-bold text-label-bold uppercase tracking-wider hover:bg-white/5 transition-colors text-center decoration-none">
                Cancel
            </a>
            <button class="px-8 py-3 rounded-DEFAULT bg-primary text-[#0A0C10] font-label-bold text-label-bold uppercase tracking-wider hover:bg-primary/90 hover:shadow-[0_0_20px_rgba(212,175,55,0.3)] transition-all flex items-center justify-center gap-2 border-0 cursor-pointer" type="submit">
                <span class="material-symbols-outlined text-[18px]">save</span>
                Save Coupon
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
