@model lagacay11.Models.ViewModels.AdminOrderListViewModel
@{
    ViewData["Title"] = "Manage Orders";
    var selStatus = Model.SelectedStatus;
    var selStartDate = Model.SelectedStartDate;
    var selEndDate = Model.SelectedEndDate;
    var selSearch = Model.SelectedSearch;
}

<div class="space-y-8">
    <div class="flex flex-col xl:flex-row justify-between xl:items-center gap-4 mb-4">
        <h3 class="font-display text-headline-md uppercase text-white tracking-wider border-l-4 border-primary pl-4">Order List</h3>
        
        <!-- Filters Form -->
        <form asp-action="Index" method="get" class="flex flex-wrap items-center gap-3 m-0">
            <!-- Search -->
            <input type="text" name="search" value="@selSearch" class="bg-background border border-white/10 text-white rounded px-3 py-2 text-xs focus:outline-none focus:border-primary placeholder-on-surface-variant/40 w-60" placeholder="Customer name, email, tx ID..." />

            <!-- Status -->
            <select name="status" class="border border-white/10 bg-surface-container text-white text-xs rounded px-3 py-2 focus:outline-none focus:border-primary w-40">
                <option value="">All Statuses</option>
                <!option value="Processing" @(selStatus == "Processing" ? "selected" : "")>Processing</!option>
                <!option value="Completed" @(selStatus == "Completed" ? "selected" : "")>Completed</!option>
                <!option value="Cancelled" @(selStatus == "Cancelled" ? "selected" : "")>Cancelled</!option>
            </select>

            <!-- Start Date -->
            <div class="flex items-center gap-2">
                <span class="text-on-surface-variant text-[10px] font-label-bold uppercase tracking-wider">From:</span>
                <input type="date" name="startDate" value="@selStartDate" class="border border-white/10 bg-surface-container text-white text-xs rounded px-3 py-2 focus:outline-none focus:border-primary w-36" />
            </div>

            <!-- End Date -->
            <div class="flex items-center gap-2">
                <span class="text-on-surface-variant text-[10px] font-label-bold uppercase tracking-wider">To:</span>
                <input type="date" name="endDate" value="@selEndDate" class="border border-white/10 bg-surface-container text-white text-xs rounded px-3 py-2 focus:outline-none focus:border-primary w-36" />
            </div>

            <button type="submit" class="bg-primary text-black font-label-bold px-4 py-2 uppercase tracking-widest text-[10px] font-bold hover:opacity-90 transition-opacity rounded-none">Filter</button>
            
            @if (!string.IsNullOrEmpty(selStatus) || !string.IsNullOrEmpty(selStartDate) || !string.IsNullOrEmpty(selEndDate) || !string.IsNullOrEmpty(selSearch))
            {
                <a asp-action="Index" class="border border-white/20 text-white hover:bg-white/10 text-[10px] px-4 py-2 font-label-bold tracking-widest uppercase decoration-none transition-colors rounded-none">Clear</a>
            }
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-dismissible glass-card border-secondary/30 text-white px-6 py-4 flex justify-between items-center mb-4 transition-all duration-500" role="alert">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-secondary">check_circle</span>
                <span class="font-sans text-sm">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="text-on-surface-variant hover:text-white transition-colors flex items-center justify-center bg-transparent border-0" onclick="this.parentElement.remove();" aria-label="Close">
                <span class="material-symbols-outlined text-lg">close</span>
            </button>
        </div>
    }

    <div class="glass-card border border-white/10 rounded-lg overflow-hidden mb-8">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-surface-container-high border-b border-white/10">
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Order ID</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Customer</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Order Date</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Total Amount</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Payment Ref</th>
                        <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Status</th>
                        <th class="px-6 py-4 text-right text-xs uppercase tracking-widest text-primary font-display font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders == null || !Model.Orders.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-8 text-center text-on-surface-variant text-sm">No orders found matching filters.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var order in Model.Orders)
                        {
                            <tr class="border-b border-white/5 hover:bg-white/2 transition-colors">
                                <td class="px-6 py-4 align-middle font-display font-bold text-white text-sm">#@order.Id</td>
                                <td class="px-6 py-4 align-middle text-white text-sm">@order.CustomerName</td>
                                <td class="px-6 py-4 align-middle text-on-surface-variant text-xs">@order.OrderDate.ToString("g")</td>
                                <td class="px-6 py-4 align-middle text-primary font-display font-bold text-base">$@order.TotalAmount.ToString("F2")</td>
                                <td class="px-6 py-4 align-middle">
                                    <code class="bg-black text-white px-2 py-1 rounded text-xs border border-white/10 font-mono">@order.PaymentReference</code>
                                </td>
                                <td class="px-6 py-4 align-middle">
                                    @if (order.Status == "Completed")
                                    {
                                        <span class="inline-block bg-secondary text-on-secondary font-label-bold px-3 py-1 text-[10px] uppercase tracking-wider">Completed</span>
                                    }
                                    else if (order.Status == "Cancelled")
                                    {
                                        <span class="inline-block bg-error/20 text-error font-label-bold px-3 py-1 text-[10px] uppercase tracking-wider border border-error/30">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="inline-block bg-primary/20 text-primary font-label-bold px-3 py-1 text-[10px] uppercase tracking-wider border border-primary/30">Processing</span>
                                    }
                                </td>
                                <td class="px-6 py-4 align-middle text-right">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="border border-white/20 text-white hover:bg-white/10 text-xs px-3 py-1.5 font-label-bold tracking-widest uppercase decoration-none transition-colors">Manage</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
