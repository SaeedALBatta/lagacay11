@using Microsoft.AspNetCore.Identity
@using lagacay11.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="auth-buttons">
@if (SignInManager.IsSignedIn(User))
{
    var appUser = await UserManager.GetUserAsync(User);
    var displayName = appUser?.FullName ?? User.Identity?.Name;

    <a asp-area="" asp-controller="Account" asp-action="Profile" class="user-badge" title="My Profile" style="text-decoration: none;">
        <div class="user-avatar">
            <span class="material-symbols-outlined">person</span>
        </div>
        <span class="user-name">@displayName</span>
    </a>
    
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-admin" asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">
            <span class="material-symbols-outlined">admin_panel_settings</span>
            <span>Admin</span>
        </a>
    }

    <form class="m-0" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="btn btn-logout">
            <span class="material-symbols-outlined">logout</span>
            <span>Logout</span>
        </button>
    </form>
}
else
{
    <a class="btn btn-outline" asp-area="" asp-controller="Account" asp-action="Login">
        <span class="material-symbols-outlined">login</span>
        <span>Log In</span>
    </a>
    <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">
        <span class="material-symbols-outlined">person_add</span>
        <span>Register</span>
    </a>
}
</div>
