@model lagacay11.Models.ViewModels.WishlistViewModel
@{
    ViewData["Title"] = "My Wishlist";
}

<div class="max-w-container-max mx-auto px-gutter py-12">
    <h2 class="font-display text-headline-md uppercase text-white tracking-wider mb-8 border-l-4 border-primary pl-4">My Wishlist</h2>

    @if (Model == null || !Model.Products.Any())
    {
        <div class="text-center py-20 glass-card border border-white/10 rounded-lg space-y-6">
            <div class="text-5xl">❤️</div>
            <h4 class="font-display text-headline-md text-white">Your wishlist is empty</h4>
            <p class="text-on-surface-variant text-sm">Save your favorite vintage jerseys here to keep track of them.</p>
            <a asp-controller="Products" asp-action="Index" class="inline-block bg-primary text-black font-label-bold px-8 py-3.5 uppercase tracking-widest text-xs font-bold hover:opacity-90 transition-opacity rounded-none decoration-none">Explore Jerseys</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8">
            @foreach (var product in Model.Products)
            {
                <div class="glass-card flex flex-col group relative jersey-card">
                    <!-- Remove from Wishlist Pin -->
                    <form asp-action="Remove" method="post" class="absolute top-4 right-4 z-20 m-0">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <button type="submit" class="w-9 h-9 rounded-full border border-white/25 flex items-center justify-center hover:bg-white/10 transition-colors bg-background/60 text-red-400" title="Remove from Wishlist">
                            <span class="material-symbols-outlined text-lg">close</span>
                        </button>
                    </form>

                    <!-- Product Image -->
                    <div class="relative overflow-hidden spotlight-bg flex items-center justify-center p-6 h-64">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="w-full h-full flex items-center justify-center decoration-none">
                            <img src="@product.MainImagePath" alt="@product.Name" class="max-h-full max-w-full object-contain group-hover:scale-110 transition-transform duration-700" />
                        </a>
                        @if (!product.IsAvailable || product.StockQuantity <= 0)
                        {
                            <div class="absolute inset-0 bg-background/70 flex items-center justify-center z-10">
                                <span class="text-white font-label-bold text-xs uppercase tracking-widest px-4 py-2 bg-red-500">Out of Stock</span>
                            </div>
                        }
                    </div>

                    <!-- Card Body -->
                    <div class="p-6 border-t border-white/10 bg-black/40 flex flex-col justify-between flex-grow">
                        <div>
                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(product.WorldCupEdition))
                                {
                                    <span class="legendary-badge text-black font-label-bold px-4 py-1 text-[10px] inline-block">🏆 @product.WorldCupEdition</span>
                                }
                                else
                                {
                                    <span class="bg-secondary text-on-secondary font-label-bold px-4 py-1 text-[10px] uppercase tracking-wider inline-block">⚽ Club Kit</span>
                                }
                            </div>

                            <h3 class="font-headline-md text-stats-xl text-white mb-1 truncate">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="text-white hover:text-primary transition-colors decoration-none">@product.Name</a>
                            </h3>
                            <p class="font-body-md text-on-surface-variant mb-4 text-xs">Year: @product.Year</p>
                        </div>

                        <div class="flex justify-between items-center border-t border-white/10 pt-4 mt-auto">
                            <span class="font-stats-xl text-primary text-lg">$@product.Price.ToString("F2")</span>

                            @if (product.IsAvailable && product.StockQuantity > 0)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="material-symbols-outlined w-9 h-9 rounded-full border border-white/20 flex items-center justify-center hover:bg-primary hover:text-black transition-all bg-transparent text-white" data-icon="add">add</button>
                                </form>
                            }
                            else
                            {
                                <span class="bg-red-500/20 text-red-400 font-label-bold px-3 py-1.5 text-[10px] uppercase tracking-wider">Sold Out</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
