@model lagacay11.Models.ViewModels.OrderDetailViewModel
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="max-w-container-max mx-auto px-gutter py-12 flex justify-center">
    <div class="glass-card p-8 md:p-12 border border-white/10 rounded-lg text-center max-w-2xl w-full space-y-6">
        <div class="text-6xl text-primary animate-pulse">
            🏆
        </div>
        <h2 class="font-display text-headline-md uppercase text-white tracking-wider">Thank you for your order!</h2>
        <p class="font-body-md text-on-surface-variant text-sm max-w-lg mx-auto">
            Your order has been placed successfully and is currently being processed.
        </p>

        <div class="glass-card p-6 text-left border border-white/10 bg-black/20 rounded-lg space-y-3">
            <h6 class="font-display text-stats-xl text-white uppercase tracking-wider border-b border-white/10 pb-3 mb-2">Order Details</h6>
            
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 py-1 text-xs items-center">
                <div class="sm:col-span-4 text-on-surface-variant/70 uppercase tracking-widest font-label-bold">Order ID:</div>
                <div class="sm:col-span-8 font-bold text-white">#@Model.Id</div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 py-1 text-xs items-center">
                <div class="sm:col-span-4 text-on-surface-variant/70 uppercase tracking-widest font-label-bold">Order Date:</div>
                <div class="sm:col-span-8 text-white">@Model.OrderDate.ToString("f")</div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 py-1 text-xs items-center">
                <div class="sm:col-span-4 text-on-surface-variant/70 uppercase tracking-widest font-label-bold">Total Amount:</div>
                <div class="sm:col-span-8 font-display font-bold text-primary text-base">$@Model.TotalAmount.ToString("F2")</div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 py-1 text-xs items-center">
                <div class="sm:col-span-4 text-on-surface-variant/70 uppercase tracking-widest font-label-bold">Shipping Address:</div>
                <div class="sm:col-span-8 text-white">@Model.ShippingAddress</div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 py-1 text-xs items-center">
                <div class="sm:col-span-4 text-on-surface-variant/70 uppercase tracking-widest font-label-bold">Payment Reference:</div>
                <div class="sm:col-span-8"><code class="bg-background text-white px-2.5 py-1 rounded text-xs border border-white/10 font-mono">@Model.PaymentReference</code></div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 py-1 text-xs items-center">
                <div class="sm:col-span-4 text-on-surface-variant/70 uppercase tracking-widest font-label-bold">Status:</div>
                <div class="sm:col-span-8"><span class="inline-block bg-primary text-black font-label-bold px-3 py-1 text-[10px] uppercase tracking-wider">@Model.Status</span></div>
            </div>
        </div>

        <div class="glass-card border border-white/10 rounded-lg overflow-hidden text-left">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-surface-container-high border-b border-white/10">
                        <th class="px-6 py-3.5 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Product</th>
                        <th class="px-6 py-3.5 text-center text-xs uppercase tracking-widest text-primary font-display font-semibold">Qty</th>
                        <th class="px-6 py-3.5 text-right text-xs uppercase tracking-widest text-primary font-display font-semibold">Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr class="border-b border-white/5 last:border-0">
                            <td class="px-6 py-3 text-xs text-white align-middle">
                                <span class="font-display font-bold block">@item.ProductName</span>
                                @if (!string.IsNullOrEmpty(item.Size))
                                {
                                    <span class="text-secondary text-[10px] uppercase tracking-wider block mt-0.5">Size: @item.Size</span>
                                }
                            </td>
                            <td class="px-6 py-3 text-xs text-on-surface-variant text-center align-middle">@item.Quantity</td>
                            <td class="px-6 py-3 text-xs text-primary text-right align-middle font-display font-bold">$@item.UnitPrice.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex justify-center pt-4">
            <a asp-controller="Products" asp-action="Index" class="inline-block bg-primary text-black font-label-bold px-8 py-3.5 uppercase tracking-widest text-xs font-bold hover:opacity-90 transition-opacity rounded-none decoration-none">Continue Shopping</a>
        </div>
    </div>
</div>
