                            <textarea name="content" rows="4" class="w-full rounded bg-background border border-white/10 text-white p-4 text-sm focus:outline-none focus:border-primary placeholder-on-surface-variant/40" placeholder="Tell us how you love your jerseys, the shipping process, or our collection catalog..." required></textarea>
                        </div>
                        <button type="submit" class="w-full bg-primary text-on-primary font-label-bold py-4 hover:opacity-90 transition-opacity uppercase tracking-wider text-sm rounded-none border-none cursor-pointer">Submit Testimonial</button>
                        <div class="text-on-surface-variant/50 text-center text-[10px]">Your feedback will be featured on the homepage after administrator approval.</div>
                    </form>
                }
                else
                {
                    <div class="text-center p-8 bg-black/35 rounded border border-white/5 py-12">
                        <p class="text-on-surface-variant mb-6 text-sm">Please log in to submit a testimonial about our shop.</p>
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Home")" class="inline-block border border-primary text-primary hover:bg-primary hover:text-background font-label-bold px-6 py-2.5 transition-all text-xs uppercase tracking-wider decoration-none">Log In</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

