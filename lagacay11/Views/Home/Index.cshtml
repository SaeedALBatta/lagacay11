<!-- Featured Products -->
<section class="py-24 bg-surface-container-lowest relative">
    <div class="px-gutter max-w-container-max mx-auto mb-12">
        <span class="text-primary font-label-bold tracking-[0.3em] uppercase block mb-2 text-xs">Exclusive Artifacts</span>
        <h2 class="font-headline-lg text-headline-lg uppercase text-white">New Arrivals</h2>
    </div>
    
    <div class="px-gutter max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        @if (retroArrivals.Any())
        {
            @foreach (var prod in retroArrivals.Take(4))
            {
                <div class="glass-card flex flex-col group relative">
                    <div class="absolute top-4 left-4 z-20">
                        @if (prod.Price >= 300)
                        {
                            <span class="legendary-badge text-black font-label-bold px-4 py-1 text-[10px]">LEGENDARY</span>
                        }
                        else if (prod.Price >= 120)
                        {
                            <span class="bg-secondary text-on-secondary font-label-bold px-4 py-1 text-[10px] uppercase tracking-wider">Rare</span>
                        }
                        else
                        {
                            <span class="bg-[#8E8E93] text-white font-label-bold px-4 py-1 text-[10px] uppercase tracking-wider">Common</span>
                        }
                    </div>
                    <div class="relative overflow-hidden aspect-[4/5] spotlight-bg p-8 flex items-center justify-center" style="height: 250px;">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@prod.Id" class="w-full h-full flex items-center justify-center decoration-none">
                            <img class="max-h-full max-w-full object-contain group-hover:scale-110 transition-transform duration-700" src="@prod.MainImagePath" alt="@prod.Name">
                        </a>
                    </div>
                    <div class="p-6 border-t border-white/10 bg-black/40 flex flex-col justify-between flex-grow">
                        <div>
                            <h3 class="font-headline-md text-stats-xl text-white mb-1 truncate">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@prod.Id" class="text-white hover:text-primary transition-colors decoration-none">@prod.Name</a>
                            </h3>
                            <p class="font-body-md text-on-surface-variant mb-4 text-sm">
                                Year: @prod.Year | @(string.IsNullOrEmpty(prod.WorldCupEdition) ? "Heritage Issue" : prod.WorldCupEdition)
                            </p>
                        </div>
                        <div class="flex justify-between items-center mt-auto">
                            <span class="font-stats-xl text-primary">$@prod.Price.ToString("F2")</span>
                            @if (prod.IsAvailable && prod.StockQuantity > 0)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@prod.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="material-symbols-outlined w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-primary hover:text-black transition-all bg-transparent text-white cursor-pointer" data-icon="add">add</button>
                                </form>
                            }
                            else
                            {
                                <span class="bg-red-500/20 text-red-400 font-label-bold px-3 py-1.5 text-xs uppercase tracking-wider">Sold Out</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Fallback Mock Cards -->
            <div class="glass-card flex flex-col group relative">
                <div class="absolute top-4 left-4 z-20">
                    <span class="legendary-badge text-black font-label-bold px-4 py-1 text-[10px]">LEGENDARY</span>
