<!-- Testimonials and Reviews Section -->
<section class="py-24 max-w-container-max mx-auto px-gutter">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
        <!-- What Collectors Say -->
        <div class="glass-card p-8 md:p-12 border border-white/10 flex flex-col justify-between">
            <div>
                <span class="text-primary font-label-bold tracking-widest uppercase block mb-2 text-xs">COLLECTOR WORDS</span>
                <h2 class="font-display text-headline-md uppercase text-white mb-8">What Collectors Say</h2>
                
                @if (testimonials.Any())
                {
                    <div class="flex flex-col gap-6 mb-8">
                        @foreach (var t in testimonials)
                        {
                            <div class="p-6 bg-black/35 border border-white/5 rounded">
                                <p class="text-on-surface-variant font-body-md italic mb-4">"@t.Content"</p>
                                <div class="flex justify-between items-center">
                                    <span class="text-primary font-label-bold uppercase text-xs tracking-wider">— @t.UserFullName</span>
                                    <span class="text-on-surface-variant/50 text-[10px]">@t.CreatedAt.ToString("yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-on-surface-variant font-body-md italic">No testimonials approved yet. Be the first to share your experience!</p>
                }
