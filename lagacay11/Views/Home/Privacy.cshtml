@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="min-h-screen bg-[#0A0C10] text-[#e2e2e8] font-body">
    <!-- Hero Banner -->
    <div class="relative py-20 overflow-hidden border-b border-white/5 bg-gradient-to-b from-[#0C0E12] via-[#0A0C10]/95 to-[#0A0C10]">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="max-w-container-max mx-auto px-6 text-center relative z-10">
            <span class="text-primary font-display font-semibold tracking-[0.25em] uppercase text-xs block mb-4">LEGAL DOCUMENTATION</span>
            <h1 class="font-display text-4xl sm:text-5xl uppercase text-white tracking-wide leading-tight">
                PRIVACY POLICY
            </h1>
            <div class="h-1 w-24 bg-primary mx-auto my-6"></div>
            <p class="text-on-surface-variant max-w-2xl mx-auto mt-6 text-sm sm:text-base leading-relaxed">
                Last updated: June 07, 2026. This policy explains how we collect, store, and process your information when using the Legacy Eleven platform.
            </p>
        </div>
    </div>

    <!-- Policy Content Sections -->
    <section class="py-16 max-w-4xl mx-auto px-6 space-y-10">
        
        <!-- Section 1 -->
        <div class="glass-card p-8 rounded-lg border border-white/10">
            <h3 class="font-display text-xl uppercase text-white mb-4 flex items-center gap-3">
                <span class="text-primary font-bold">1.</span> Information We Collect
            </h3>
            <p class="text-on-surface-variant text-sm leading-relaxed mb-4">
                We collect information you provide directly to us when creating an account, making a purchase, subscribing to our drops newsletter, or contacting us. This includes:
            </p>
            <ul class="list-disc pl-6 text-on-surface-variant text-xs space-y-2">
                <li>Personal identifiers: Full Name, email address, physical shipping address, phone number.</li>
                <li>Transactional information: Cart items, checkout configurations, and purchase history.</li>
                <li>Account credentials: Hashed passwords and session configurations.</li>
            </ul>
        </div>

        <!-- Section 2 -->
        <div class="glass-card p-8 rounded-lg border border-white/10">
            <h3 class="font-display text-xl uppercase text-white mb-4 flex items-center gap-3">
                <span class="text-primary font-bold">2.</span> Payment Security & Processing
            </h3>
            <p class="text-on-surface-variant text-sm leading-relaxed mb-4">
                Your payment safety is our highest priority. All transaction details are processed securely:
            </p>
            <ul class="list-disc pl-6 text-on-surface-variant text-xs space-y-2">
                <li>We do not store your credit card or billing details on our local database servers.</li>
                <li>All checkout workflows utilize Stripe API tokenization and secure TLS 1.3 encryption.</li>
                <li>Transactions are fully compliant with PCI-DSS (Payment Card Industry Data Security Standard).</li>
            </ul>
        </div>

        <!-- Section 3 -->
        <div class="glass-card p-8 rounded-lg border border-white/10">
            <h3 class="font-display text-xl uppercase text-white mb-4 flex items-center gap-3">
                <span class="text-primary font-bold">3.</span> Cookies and Tracking
            </h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">
                We use secure functional cookies to manage your shopping cart state, keep you signed in across page transitions, and store regional settings. You can manage or disable cookie configurations in your web browser preferences, though some functions like cart persistence may be restricted.
            </p>
        </div>

        <!-- Section 4 -->
        <div class="glass-card p-8 rounded-lg border border-white/10">
            <h3 class="font-display text-xl uppercase text-white mb-4 flex items-center gap-3">
                <span class="text-primary font-bold">4.</span> Your Rights and Data Control
            </h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">
                Under relevant data protection laws (including GDPR), you retain full rights regarding your data. You may request information export, correction, or deletion of your account and personal details at any time by contacting our support team at <span class="text-primary">support@legacyeleven.com</span>.
            </p>
        </div>

    </section>
</div>
