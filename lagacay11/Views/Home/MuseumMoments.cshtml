                <!-- Content Area -->
                <div class="p-6 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="font-display-lg text-2xl uppercase text-white mb-2 tracking-wide">The Golden Strike</h3>
                        <p class="font-body-md text-on-surface-variant text-sm leading-relaxed mb-6">
                            Andrés Iniesta's dramatic 116th-minute extra-time volley broke Dutch hearts and propelled Spain's 'tiki-taka' generation to their first-ever World Cup title.
                        </p>
                    </div>

                    <div>
                        <!-- Accordion Button -->
                        <button onclick="toggleStats(this, 'stats-iniesta')" class="w-full py-2.5 px-4 text-xs text-primary hover:text-white uppercase tracking-wider font-label-bold border border-primary/20 hover:border-primary bg-primary/5 rounded transition-all duration-300 flex items-center justify-center gap-2 mb-3">
                            <span>Show Match Details & Stats</span>
                            <span class="material-symbols-outlined text-sm">keyboard_arrow_down</span>
                        </button>

                        <!-- Hidden Stats Panel -->
                        <div id="stats-iniesta" class="hidden overflow-hidden transition-all duration-500 max-h-0 opacity-0 mb-4">
                            <div class="p-4 bg-black/40 rounded border border-white/5 space-y-3">
                                <div class="grid grid-cols-2 gap-2 text-[11px] font-label-bold text-on-surface-variant/70 border-b border-white/5 pb-2">
                                    <div>MATCH</div><div class="text-right text-white font-body-md">Spain 1 - 0 Netherlands</div>
                                    <div>DATE</div><div class="text-right text-white font-body-md">July 11, 2010</div>
                                    <div>VENUE</div><div class="text-right text-white font-body-md">Soccer City, Johannesburg</div>
                                </div>
                                <div class="text-xs text-on-surface-variant/80 leading-relaxed font-body-md">
                                    <strong>Stat of the Match:</strong> Iniesta scored the latest winning goal in a World Cup Final. Spain became the first European team to win the tournament outside Europe.
                                </div>
                            </div>
                        </div>

                        <!-- Browse Shop Link -->
                        @if (ViewBag.Iniesta2010ProductId != null)
                        {
                            <a href="/Products/Details/@ViewBag.Iniesta2010ProductId" class="w-full py-3 bg-primary hover:bg-primary-fixed text-black hover:text-black text-center font-label-bold uppercase text-xs tracking-widest rounded transition-all duration-300 block decoration-none">
                                Browse Memorabilia
                            </a>
                        }
                        else
                        {
                            <a href="/Products?search=Spain+2010" class="w-full py-3 bg-primary hover:bg-primary-fixed text-black hover:text-black text-center font-label-bold uppercase text-xs tracking-widest rounded transition-all duration-300 block decoration-none">
                                Browse Memorabilia
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Moment Card 6: Ronaldo -->
            <div class="glass-card flex flex-col group relative border border-white/10 bg-black/40 rounded-xl overflow-hidden shadow-2xl hover:border-primary/30 transition-all duration-500 hover:-translate-y-2">
                <!-- Image Container -->
                <div class="relative aspect-[4/3] overflow-hidden">
                    <img class="w-full h-full object-cover transition-transform duration-[1000ms] group-hover:scale-110" 
                         src="https://miro.medium.com/v2/resize:fit:640/1*pt2ILIueMfxPC-TIRzuXvQ.jpeg" 
