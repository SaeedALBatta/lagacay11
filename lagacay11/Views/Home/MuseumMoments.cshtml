                    </div>
                </div>

                <!-- Content Area -->
                <div class="p-6 flex-grow flex flex-col justify-between">
                    <div>
                        <h3 class="font-display-lg text-2xl uppercase text-white mb-2 tracking-wide">Ronaldo's Redemption</h3>
                        <p class="font-body-md text-on-surface-variant text-sm leading-relaxed mb-6">
                            Ronaldo Nazário scored both goals in the final against Germany, completing a legendary comeback from career-threatening knee injuries to secure Brazil's fifth World Cup.
                        </p>
                    </div>

                    <div>
                        <!-- Accordion Button -->
                        <button onclick="toggleStats(this, 'stats-ronaldo')" class="w-full py-2.5 px-4 text-xs text-primary hover:text-white uppercase tracking-wider font-label-bold border border-primary/20 hover:border-primary bg-primary/5 rounded transition-all duration-300 flex items-center justify-center gap-2 mb-3">
                            <span>Show Match Details & Stats</span>
                            <span class="material-symbols-outlined text-sm">keyboard_arrow_down</span>
