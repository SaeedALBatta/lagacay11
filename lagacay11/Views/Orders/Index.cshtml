@model lagacay11.Models.ViewModels.UserOrdersListViewModel
@{
    ViewData["Title"] = "My Orders";
}

<div class="max-w-container-max mx-auto px-gutter py-12">
    <h2 class="font-display text-headline-md uppercase text-white tracking-wider mb-8 border-l-4 border-primary pl-4">My Order History</h2>

    @if (Model.Orders == null || !Model.Orders.Any())
    {
        <div class="text-center py-20 glass-card border border-white/10 rounded-lg space-y-6">
            <div class="text-5xl">📦</div>
            <h4 class="font-display text-headline-md text-white">No orders found</h4>
            <p class="text-on-surface-variant text-sm">You haven't purchased any jerseys yet.</p>
            <a asp-controller="Products" asp-action="Index" class="inline-block bg-primary text-black font-label-bold px-8 py-3.5 uppercase tracking-widest text-xs font-bold hover:opacity-90 transition-opacity rounded-none decoration-none">Browse Catalog</a>
        </div>
    }
    else
    {
        <div class="glass-card border border-white/10 rounded-lg overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="bg-surface-container-high border-b border-white/10">
                            <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Order ID</th>
                            <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Order Date</th>
                            <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Total Amount</th>
                            <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Payment Reference</th>
                            <th class="px-6 py-4 text-left text-xs uppercase tracking-widest text-primary font-display font-semibold">Status</th>
                            <th class="px-6 py-4 text-right text-xs uppercase tracking-widest text-primary font-display font-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr class="border-b border-white/5 hover:bg-white/2 transition-colors">
                                <td class="px-6 py-4 align-middle font-bold text-white">#@order.Id</td>
                                <td class="px-6 py-4 align-middle text-white text-xs">@order.OrderDate.ToString("f")</td>
                                <td class="px-6 py-4 align-middle text-primary font-display font-bold text-base">$@order.TotalAmount.ToString("F2")</td>
                                <td class="px-6 py-4 align-middle">
                                    <code class="bg-background text-white px-2.5 py-1 rounded text-xs border border-white/10 font-mono">@order.PaymentReference</code>
                                </td>
                                <td class="px-6 py-4 align-middle">
                                    @if (order.Status == "Completed")
                                    {
                                        <span class="inline-block bg-secondary text-on-secondary font-label-bold px-3 py-1 text-[10px] uppercase tracking-wider">@order.Status</span>
                                    }
                                    else if (order.Status == "Cancelled")
                                    {
                                        <span class="inline-block bg-red-500 text-white font-label-bold px-3 py-1 text-[10px] uppercase tracking-wider">@order.Status</span>
                                    }
                                    else
                                    {
                                        <span class="inline-block bg-primary text-black font-label-bold px-3 py-1 text-[10px] uppercase tracking-wider">@order.Status</span>
                                    }
                                </td>
                                <td class="px-6 py-4 align-middle text-right">
                                    <div class="flex justify-end gap-2">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="border border-white/20 text-white hover:bg-white/10 text-xs px-4 py-2 font-label-bold tracking-widest uppercase decoration-none transition-colors">Details</a>
                                        <a asp-action="Invoice" asp-route-id="@order.Id" target="_blank" class="border border-primary text-primary hover:bg-primary hover:text-black text-xs px-4 py-2 font-label-bold tracking-widest uppercase decoration-none transition-all flex items-center gap-1">
                                            <span class="material-symbols-outlined text-sm">print</span>
                                            <span>Invoice</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
