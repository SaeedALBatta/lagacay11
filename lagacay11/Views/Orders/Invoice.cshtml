@model lagacay11.Models.ViewModels.InvoiceViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice - Order #@Model.Id</title>
    <!-- Compiled Tailwind CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-white text-gray-900 font-sans p-6" id="invoicePrintPage">
    <div class="max-w-3xl mx-auto my-12">
        <!-- Header -->
        <div class="flex justify-between items-center border-b border-gray-200 pb-6 mb-8">
            <div>
                <h2 class="text-3xl font-display font-bold tracking-wider text-gray-900 mb-1">LEGACY ELEVEN</h2>
                <span class="text-gray-500 text-xs uppercase tracking-widest font-semibold">Vintage Jersey Boutique</span>
            </div>
            <div class="text-right">
                <h4 class="text-xl font-display font-bold text-gray-700 uppercase tracking-wider mb-1">Invoice</h4>
                <span class="text-gray-900 text-sm font-semibold">Order #@Model.Id</span>
            </div>
        </div>

        <!-- Meta Grid -->
        <div class="grid grid-cols-2 gap-8 mb-8 text-xs">
            <div>
                <span class="text-gray-400 font-bold uppercase tracking-widest block mb-2">Billed To</span>
                <strong class="text-gray-900 text-sm">@Model.CustomerName</strong>
                <span class="text-gray-600 block mt-1">Email: @Model.CustomerEmail</span>
                <span class="text-gray-600 block">Phone: @Model.CustomerPhone</span>
            </div>
            <div class="text-right">
                <span class="text-gray-400 font-bold uppercase tracking-widest block mb-2">Order Details</span>
                <span class="text-gray-600 block">Date: @Model.OrderDate.ToString("d")</span>
                <span class="text-gray-600 block">Status: @Model.Status</span>
                <span class="text-gray-600 block">Payment Ref: @Model.PaymentReference</span>
            </div>
        </div>

        <div class="mb-8 border-t border-gray-100 pt-4 text-xs">
            <span class="text-gray-400 font-bold uppercase tracking-widest block mb-2">Shipping Address</span>
            <p class="text-gray-700 leading-relaxed">@Model.ShippingAddress</p>
        </div>

        <!-- Items Table -->
        <div class="border border-gray-200 rounded-lg overflow-hidden mb-8">
            <table class="w-full border-collapse text-left">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200">
                        <th class="px-6 py-3.5 text-left text-xs uppercase tracking-widest text-gray-500 font-semibold">Item Description</th>
                        <th class="px-6 py-3.5 text-center text-xs uppercase tracking-widest text-gray-500 font-semibold">Qty</th>
                        <th class="px-6 py-3.5 text-right text-xs uppercase tracking-widest text-gray-500 font-semibold">Unit Price</th>
                        <th class="px-6 py-3.5 text-right text-xs uppercase tracking-widest text-gray-500 font-semibold">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 text-xs">
                                <strong class="text-gray-900 font-bold">@item.ProductName</strong>
                                <span class="text-gray-500 block mt-1">
                                    Year: @item.ProductYear
                                    @if (!string.IsNullOrEmpty(item.Size))
                                    {
                                        <span> | Size: @item.Size</span>
                                    }
                                    | Tournament: @(string.IsNullOrEmpty(item.WorldCupEdition) ? "N/A" : item.WorldCupEdition)
                                </span>
                            </td>
                            <td class="px-6 py-4 text-xs text-center font-semibold text-gray-800">@item.Quantity</td>
                            <td class="px-6 py-4 text-xs text-right text-gray-600">$@item.UnitPrice.ToString("F2")</td>
                            <td class="px-6 py-4 text-xs text-right font-semibold text-gray-900">$@item.Subtotal.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="bg-gray-50 font-bold border-t border-gray-200">
                        <td colspan="3" class="px-6 py-4 text-right text-xs uppercase tracking-widest text-gray-600">Total Amount:</td>
                        <td class="px-6 py-4 text-right text-sm text-gray-900">$@Model.TotalAmount.ToString("F2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Footer -->
        <div class="text-center border-t border-gray-200 pt-6 mt-12 text-gray-400 text-xs">
            <p class="mb-1 font-semibold">Thank you for shopping with Legacy Eleven!</p>
            <p>If you have any questions regarding this invoice, contact support@legacyeleven.com</p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
